<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.user.scientific-discovery</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>/PATH/TO/REPOSITORY/scripts/research_resume.sh</string></array>
  <key>WorkingDirectory</key><string>/PATH/TO/REPOSITORY</string>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
</dict>
</plist>
