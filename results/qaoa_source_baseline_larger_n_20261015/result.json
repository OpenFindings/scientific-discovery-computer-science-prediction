  "hypothesis": "At the frozen source-style depth-1 QAOA parameters, distance-at-least-3 alternating postselection changes expected satisfied-edge count relative to the unconditioned state on a larger n=10 simple 3-regular graph sample.",
  "competing_explanations": [
    "Any observed difference is a finite-size or graph-family effect and does not persist outside this exact n=10 seeded sample.",
    "The apparent difference depends on the fixed source parameter convention or the deterministic greedy pair rule rather than the conditioning concept generally."
  ],
  "method": "Exact NumPy complex state-vector simulation for 20 independently generated simple 3-regular graphs at n=10. For each graph, generate one depth-1 state with the frozen source convention, compute the unconditioned expected cut, choose the first deterministic pair at graph distance at least 3, condition on the fixed alternating assignment (vertex 0 bit 0, vertex 1 bit 1), and compute the paired graph-level difference. No graph was filtered after observing outcomes.",
  "configuration": {
    "vertices": 10,
    "graphs": 20,
    "seed": 20261015,
    "beta": -0.7853981633974483,
    "gamma": 0.7853981633974483,
    "assignment": "alternating +1,-1 / bits 0,1",
    "graph_generator": "rejection-sampled simple 3-regular configuration model",
    "distance_threshold": 3,
    "pair_rule": "lexicographically first pair with graph distance >= 3",
    "state_convention": "exp(-i beta H_B/2) exp(-i gamma H_C/2), H_C=-cut",
    "uncertainty_unit": "independent generated graph"
  },
  "predeclared_gate": "All 20 graphs must have a distance-at-least-3 pair and positive exact conditioning probability; otherwise setup failure is recorded and no conditioned effect estimate is asserted.",
